# Copy this file to .env and fill in your real values before running.
RESY_API_KEY=
# Static anonymous-session token — NOT the user auth token.
# Capture from the X-Resy-Universal-Auth header in any api.resy.com request
# made by your browser while logged OUT of resy.com (incognito works well).
RESY_UNIVERSAL_AUTH=
# Dynamic auth: ResyAuthService uses these to obtain and cache a user token.
RESY_EMAIL=
RESY_PASSWORD=
# Legacy static user token — used only by the POST /api/book/ fallback path.
RESY_AUTH_TOKEN=
USER_AGENT=Chrome/124.0.0.0
